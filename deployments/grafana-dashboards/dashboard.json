{
    "title": "Distributed Counter Monitoring",
    "panels": [
        {
            "title": "Counter Value per Node",
            "type": "graph",
            "targets": [
                {
                    "expr": "counter_current_value{node_id=~\"node-.*\"}",
                    "legendFormat": "{{node_id}}"
                }
            ]
        },
        {
            "title": "Gossip Messages per Second",
            "type": "graph",
            "targets": [
                {
                    "expr": "rate(gossip_messages_sent_total[1m])",
                    "legendFormat": "Sent"
                },
                {
                    "expr": "rate(gossip_messages_received_total[1m])",
                    "legendFormat": "Received"
                }
            ]
        },
        {
            "title": "Cluster Node Status",
            "type": "stat",
            "targets": [
                {
                    "expr": "count(up{job=\"distributed-counter\"})",
                    "legendFormat": "Active Nodes"
                }
            ]
        },
        {
            "title": "Recovery Retry Rate",
            "type": "graph",
            "targets": [
                {
                    "expr": "sum by (node_id) (rate(recovery_retry_total[5m]))",
                    "legendFormat": "{{node_id}}"
                }
            ]
        },
        {
            "title": "Recovery Seed Failures",
            "type": "graph",
            "targets": [
                {
                    "expr": "sum by (node_id, seed_node) (rate(recovery_seed_failures_total[5m]))",
                    "legendFormat": "{{node_id}} / {{seed_node}}"
                }
            ]
        },
        {
            "title": "Recovery Sync p95",
            "type": "graph",
            "targets": [
                {
                    "expr": "histogram_quantile(0.95, sum by (le, node_id, seed_node) (rate(recovery_sync_duration_seconds_bucket[5m])))",
                    "legendFormat": "{{node_id}} / {{seed_node}}"
                }
            ]
        },
        {
            "title": "Recovery In Progress",
            "type": "stat",
            "targets": [
                {
                    "expr": "recovery_in_progress",
                    "legendFormat": "Recovering"
                }
            ]
        }
    ]
}